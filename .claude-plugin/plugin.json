{
  "name": "reference-data-mcp-server",
  "version": "0.1.13",
  "description": "Look up countries, timezones, periodic table elements, physical constants, units, HTTP status codes, and MIME types via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads"
  },
  "homepage": "https://github.com/cyanheads/reference-data-mcp-server#readme",
  "repository": "https://github.com/cyanheads/reference-data-mcp-server.git",
  "license": "Apache-2.0",
  "mcpServers": {
    "reference-data-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/reference-data-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
